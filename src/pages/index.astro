---
// Pagina provvisoria con un campionario degli stili base: la Home vera arriva con T28.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Omaggio a Ennio Morricone — Diego Basso, Orchestra Ritmico Sinfonica Italiana"
  description="Il progetto ideato nel 2004 dal Maestro Diego Basso: l’Orchestra Ritmico Sinfonica Italiana e il soprano Claudia Sasso nella musica per il cinema di Ennio Morricone."
  alternate={[{ lang: 'it', href: '/' }]}
  noindex
>
  <section class="sezione contenitore">
    <div class="sezione__testa">
      <p class="occhiello om-oro">Diego Basso dirige</p>
      <h1 class="titolo-xl">Un concerto che diventa racconto</h1>
    </div>
    <p class="evocativo-xl">Musica e cinema in un unico grande spettacolo</p>
  </section>
  <section class="sezione contenitore" data-reveal>
    <div class="sezione__testa">
      <p class="occhiello om-tenue">Sito in costruzione</p>
      <h2 class="titolo-l">Il progetto</h2>
    </div>
    <div class="testo">
      <p class="lead">Musica e cinema in un unico grande spettacolo.</p>
      <p class="corpo">
        Il pubblico passa dalla dimensione epica dei western di Sergio Leone alla delicatezza di
        <em>Nuovo Cinema Paradiso</em>, dalla spiritualità di <em>The Mission</em> alle atmosfere
        sospese di <em>C’era una volta in America</em>.
      </p>
      <p class="citazione">Un’emozione riconoscibile anche ad occhi chiusi.</p>
    </div>
  </section>
  <section class="sezione contenitore" data-reveal>
    <p class="numero-data">12.07</p>
    <p class="titolo-m">Teatro Verdi · Padova</p>
    <p class="coordinate om-tenue">45.4093° N · 11.8715° E</p>
    <p class="evocativo">Nuovo Cinema Paradiso</p>
    <p class="crediti">Orchestra Ritmico Sinfonica Italiana</p>
    <p class="didascalia om-tenue">Esempio di stili: dati non reali</p>
    <p style="margin-top: var(--spazio-6)">
      <a class="om-pulsante om-pulsante--oro" href="#contenuto">
        Prossime date
      </a>
      <a class="om-pulsante om-pulsante--contorno" href="#contenuto">
        Scarica il press kit
      </a>
    </p>
  </section>
</BaseLayout>
