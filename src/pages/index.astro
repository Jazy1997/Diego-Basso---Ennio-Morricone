---
// Pagina provvisoria con un campionario degli stili base: la Home vera arriva con T28.
import BaseLayout from '../layouts/BaseLayout.astro';
import Pulsante from '../components/Pulsante.astro';
import Etichetta from '../components/Etichetta.astro';
import Cinemascope from '../components/Cinemascope.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Testata from '../components/Testata.astro';
import { precaricaPoster } from '../lib/hero';
import { prendi } from '../lib/contenuti';

const poster = await precaricaPoster();
const nomi = ['eventi', 'persone', 'luoghi', 'partner', 'contatti', 'link', 'foto'] as const;
const conteggi = await Promise.all(nomi.map(async (n) => `${n} ${(await prendi(n)).length}`));
---

<BaseLayout
  title="Omaggio a Ennio Morricone — Diego Basso, Orchestra Ritmico Sinfonica Italiana"
  description="Il progetto ideato nel 2004 dal Maestro Diego Basso: l’Orchestra Ritmico Sinfonica Italiana e il soprano Claudia Sasso nella musica per il cinema di Ennio Morricone."
  alternate={[{ lang: 'it', href: '/' }]}
  noindex
>
  <link slot="head" rel="preload" as="image" fetchpriority="high" {...poster} />
  <Testata slot="testata" trasparente />
  <HeroVideo />
  <section class="sezione contenitore" data-reveal>
    <div class="sezione__testa">
      <p class="occhiello om-tenue">Sito in costruzione</p>
      <h2 class="titolo-l">Il progetto</h2>
    </div>
    <div class="testo">
      <p class="lead">Musica e cinema in un unico grande spettacolo.</p>
      <p class="corpo">
        Il pubblico passa dalla dimensione epica dei western di Sergio Leone alla delicatezza di
        <em>Nuovo Cinema Paradiso</em>, dalla spiritualità di <em>The Mission</em> alle atmosfere
        sospese di <em>C’era una volta in America</em>.
      </p>
      <p class="citazione">Un’emozione riconoscibile anche ad occhi chiusi.</p>
    </div>
  </section>
  <section class="sezione contenitore" data-reveal>
    <p class="numero-data">12.07</p>
    <p class="titolo-m">Teatro Verdi · Padova</p>
    <p class="coordinate om-tenue">45.4093° N · 11.8715° E</p>
    <p class="evocativo">Nuovo Cinema Paradiso</p>
    <p class="crediti">Orchestra Ritmico Sinfonica Italiana</p>
    <p class="didascalia om-tenue">Esempio di stili: dati non reali</p>
  </section>
  <section class="sezione contenitore" data-reveal>
    <div class="sezione__testa">
      <p class="occhiello om-tenue">Campionario componenti</p>
      <h2 class="titolo-l">Pulsanti ed etichette</h2>
    </div>
    <div class="om-riga">
      <Pulsante href="#contenuto">Prossime date</Pulsante>
      <Pulsante href="#contenuto" variante="contorno">Scarica il press kit</Pulsante>
      <Pulsante href="#contenuto" variante="testo">Tutte le date</Pulsante>
      <Pulsante href="https://www.example.com" variante="contorno" piccolo esterno>Biglietti</Pulsante>
      <Pulsante href="#contenuto" piccolo disabilitato>Biglietti</Pulsante>
    </div>
    <div class="om-riga" style="margin-top: var(--spazio-6)">
      <Etichetta tipo="nuova" />
      <Etichetta tipo="ultimi" />
      <Etichetta tipo="esaurito" />
      <Etichetta tipo="proiezioni" />
      <Etichetta tipo="nuova" lang="en" />
      <Etichetta tipo="esaurito" lang="en" />
    </div>
    <p class="didascalia om-tenue" style="margin-top: var(--spazio-6)" data-conteggi>
      Collezioni: {conteggi.join(' · ')}
    </p>
  </section>
  <section class="sezione" data-reveal>
    <Cinemascope
      foto="orchestra-schermo-03"
      occhiello="Il progetto"
      sottotitolo="Un viaggio tra proiezioni e musica"
      filetto
    />
  </section>
  <section class="sezione contenitore" data-reveal>
    <Cinemascope foto="luogo-castello-01" sizes="(min-width: 1568px) 1440px, 92vw">
      <Fragment slot="bassa">
        <p class="titolo-m">Teatro Verdi · Padova</p>
        <p class="coordinate om-tenue">45.4093° N · 11.8713° E</p>
      </Fragment>
    </Cinemascope>
  </section>
</BaseLayout>
