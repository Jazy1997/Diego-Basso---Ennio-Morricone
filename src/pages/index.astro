---
// Pagina provvisoria: la Home vera arriva con T28.
import '../styles/global.css';
import FontPreload from '../components/FontPreload.astro';
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Omaggio a Ennio Morricone</title>
    <FontPreload />
  </head>
  <body style="padding: var(--margine-web)">
    <p class="om-oro" style="font: 600 13px/16px var(--font-display); letter-spacing: 0.28em">
      DIEGO BASSO DIRIGE
    </p>
    <h1 style="font: 800 clamp(48px, 8vw, 88px)/0.92 var(--font-display); text-transform: uppercase">
      Omaggio a Ennio Morricone
    </h1>
    <p style="font: italic 500 30px/1.2 var(--font-accento)">
      Musica e cinema in un unico grande spettacolo
    </p>
    <p style="font: 400 17px/28px var(--font-testo)">Sito in costruzione.</p>
  </body>
</html>
