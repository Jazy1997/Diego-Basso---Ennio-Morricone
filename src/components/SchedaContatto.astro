---
// Scheda di un contatto (ARCHITECTURE.md §8): riquadro sala-200 ad angoli vivi, email e telefono cliccabili.
interface Props {
  titolo: string;
  nome?: string;
  email: string;
  telefono?: string;
  segnaposto?: boolean;
}

const { titolo, nome, email, telefono, segnaposto = false } = Astro.props;
const tel = telefono?.replace(/[^\d+]/g, '');
---

<div class:list={['scheda-contatto', segnaposto && 'segnaposto']}>
  <h3 class="occhiello om-tenue">{titolo}</h3>
  {nome && <p class="scheda-contatto__nome">{nome}</p>}
  <p><a href={`mailto:${email}`}>{email}</a></p>
  {telefono && <p><a href={`tel:${tel}`}>{telefono}</a></p>}
</div>

<style>
  .scheda-contatto {
    display: flex;
    flex-direction: column;
    gap: var(--spazio-2);
    padding: var(--spazio-6);
    background: var(--sala-200);
    border-radius: var(--raggio-0);
  }

  .scheda-contatto h3 {
    margin-bottom: var(--spazio-2);
  }

  .scheda-contatto__nome {
    color: var(--avorio);
  }

  .scheda-contatto a {
    overflow-wrap: anywhere;
  }
</style>
