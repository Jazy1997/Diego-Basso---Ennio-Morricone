---
// Etichetta di stato (DS › Etichetta): una sola per data, testi fissi IT/EN.
import type { Lingua } from './Seo.astro';

export type TipoEtichetta = 'nuova' | 'ultimi' | 'esaurito' | 'proiezioni';

interface Props {
  tipo: TipoEtichetta;
  lang?: Lingua;
}

const { tipo, lang = 'it' } = Astro.props;

const TESTI: Record<TipoEtichetta, Record<Lingua, string>> = {
  nuova: { it: 'Nuova data', en: 'New date' },
  ultimi: { it: 'Ultimi posti', en: 'Last tickets' },
  esaurito: { it: 'Esaurito', en: 'Sold out' },
  proiezioni: { it: 'Con proiezioni', en: 'With projections' },
};
---

<span
  class:list={[
    'om-etichetta',
    tipo === 'nuova' && 'om-etichetta--nuova',
    tipo === 'esaurito' && 'om-etichetta--esaurito',
  ]}
>
  {TESTI[tipo][lang]}
</span>
