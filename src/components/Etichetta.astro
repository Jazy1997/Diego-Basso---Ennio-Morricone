---
// Etichetta di stato (DS › Etichetta): una sola per data, testi fissi IT/EN.
import type { Lingua } from './Seo.astro';
import { t } from '../i18n/utils';

export type TipoEtichetta = 'nuova' | 'ultimi' | 'esaurito' | 'proiezioni';

interface Props {
  tipo: TipoEtichetta;
  lang?: Lingua;
}

const { tipo, lang = 'it' } = Astro.props;
---

<span
  class:list={[
    'om-etichetta',
    tipo === 'nuova' && 'om-etichetta--nuova',
    tipo === 'esaurito' && 'om-etichetta--esaurito',
  ]}
>
  {t(lang).etichette[tipo]}
</span>
