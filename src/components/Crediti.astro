---
// Crediti in stile locandina (DS › Crediti): contenuto e ordine fissi, nomi mai abbreviati.
// `centrato` solo dentro una banda Cinemascope a tutta larghezza.
import type { Lingua } from './Seo.astro';
import { t } from '../i18n/utils';

interface Props {
  lang?: Lingua;
  centrato?: boolean;
}

const { lang = 'it', centrato = false } = Astro.props;

const T = t(lang).crediti;
const VOCI = [
  { ruolo: T.direttore, nome: 'Diego Basso' },
  { ruolo: T.soprano, nome: 'Claudia Sasso' },
  { ruolo: T.orchestra, nome: 'Orchestra Ritmico Sinfonica Italiana' },
];
---

<dl class:list={['om-crediti', centrato && 'om-crediti--centrato']}>
  {
    VOCI.map((v) => (
      <div class="om-crediti__voce">
        <dt>{v.ruolo}</dt>
        <dd>{v.nome}</dd>
      </div>
    ))
  }
</dl>

<style>
  @media (max-width: 720px) {
    .om-crediti {
      flex-direction: column;
      gap: var(--spazio-4);
    }

    .om-crediti--centrato {
      align-items: center;
    }

    .om-crediti__voce,
    .om-crediti--centrato .om-crediti__voce:first-child {
      padding-inline: 0;
      border-left: 0;
    }
  }
</style>
