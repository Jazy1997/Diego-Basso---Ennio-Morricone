---
// Trailer 16:9 con facciata (ARCHITECTURE.md §8, §15): finché non si clicca nessuna richiesta a YouTube.
// È un link al video (funziona anche senza JS); lo script lo sostituisce con l'iframe youtube-nocookie in autoplay.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lingua } from './Seo.astro';
import { t } from '../i18n/utils';
import Icona from './Icona.astro';

interface Props {
  youtubeId: string;
  titolo: string;
  poster: ImageMetadata;
  lang?: Lingua;
}

const { youtubeId, titolo, poster, lang = 'it' } = Astro.props;
const etichetta = `${t(lang).comune.riproduciVideo}: ${titolo}`;
---

<div class="trailer" data-trailer data-id={youtubeId} data-titolo={titolo}>
  <a
    class="trailer__avvia"
    href={`https://www.youtube.com/watch?v=${youtubeId}`}
    aria-label={etichetta}
  >
    <Picture
      src={poster}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 960, 1280]}
      sizes="(min-width: 1568px) 1440px, 92vw"
      class="trailer__poster"
    />
    <span class="om-grana" aria-hidden="true"></span>
    <span class="trailer__play" aria-hidden="true">
      <Icona nome="play" misura={32} />
    </span>
  </a>
</div>

<script>
  import '../scripts/trailer.ts';
</script>

<style>
  .trailer {
    position: relative;
    aspect-ratio: var(--rapporto-video);
    background: var(--sala-000);
    overflow: hidden;
  }

  .trailer__avvia,
  .trailer :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .trailer__avvia {
    display: grid;
    place-items: center;
  }

  .trailer :global(picture) {
    display: contents;
  }

  .trailer :global(.trailer__poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .trailer__play {
    position: relative;
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    padding-left: 4px; /* centro ottico del triangolo */
    border: 1px solid var(--avorio);
    border-radius: var(--raggio-tondo);
    background: var(--velo);
    color: var(--avorio);
    transition:
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .trailer__avvia:hover .trailer__play,
  .trailer__avvia:focus-visible .trailer__play {
    border-color: var(--oro);
    color: var(--oro);
  }

  /* L'anello di focus va sul cerchio, non sull'intera finestra */
  .trailer__avvia:focus-visible {
    box-shadow: none;
  }

  .trailer__avvia:focus-visible .trailer__play {
    box-shadow: var(--anello-focus);
  }

  @media (max-width: 720px) {
    .trailer__play {
      width: 64px;
      height: 64px;
    }
  }
</style>
