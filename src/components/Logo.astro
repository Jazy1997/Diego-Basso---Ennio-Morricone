---
// Il logo del progetto, solo dai 4 file originali (DS › Logo). Rifiuta misure sotto il minimo:
// verticale 240 px, orizzontale 280 px.
// Gli SVG nascono da "Logo Morricone.svg" con scripts/loghi-svg.mjs: nitidi a ogni misura, nessun ricampionamento.
const file = import.meta.glob<string>('../assets/logo/*.svg', { query: '?url', import: 'default', eager: true });
const sorgenti = import.meta.glob<string>('../assets/logo/*.svg', { query: '?raw', import: 'default', eager: true });

interface Props {
  colore?: 'oro' | 'bianco';
  forma?: 'verticale' | 'orizzontale';
  larghezza: number; // px CSS
  class?: string;
  caricamento?: 'eager' | 'lazy';
}

const {
  colore = 'oro',
  forma = 'orizzontale',
  larghezza,
  class: classe,
  caricamento = 'lazy',
} = Astro.props;

const MINIMI = { verticale: 240, orizzontale: 280 } as const;
if (larghezza < MINIMI[forma]) {
  throw new Error(
    `Logo ${forma} largo ${larghezza}px: il minimo del Design System è ${MINIMI[forma]}px. Scrivi il titolo in testo.`,
  );
}

const percorso = `../assets/logo/logo-${colore}-${forma}.svg`;
const [, , w, h] = sorgenti[percorso].match(/viewBox="([^"]+)"/)![1].split(' ').map(Number);
const altezza = Math.round((larghezza * h) / w);
---

<img
  src={file[percorso]}
  alt="Omaggio a Ennio Morricone"
  width={larghezza}
  height={altezza}
  loading={caricamento}
  decoding="async"
  class={classe}
/>
