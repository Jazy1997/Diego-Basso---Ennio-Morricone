---
// Hero della Home (ARCHITECTURE.md §7.2): finestra Cinemascope a tutta larghezza con il video muto in loop.
// Il poster è un <Picture> sotto il video (LCP, precaricato con precaricaPoster() di lib/hero.ts).
// Animazione firma: la finestra parte 16:9 e le bande la chiudono a 2,39:1 in 0,8 s.
// Con reduced-motion o Save-Data niente animazione e niente riproduzione automatica: resta il poster.
import { Picture } from 'astro:assets';
import type { Lingua } from './Seo.astro';
import Logo from './Logo.astro';
import Pulsante from './Pulsante.astro';
import Icona from './Icona.astro';
import { POSTER } from '../lib/hero';

interface Props {
  lang?: Lingua;
  hrefDate?: string;
  /** Il logo è l'h1 della pagina (Home). */
  titolo?: boolean;
}

const { lang = 'it', hrefDate = lang === 'it' ? '/date/' : '/en/dates/', titolo = true } = Astro.props;

const T = {
  it: {
    occhiello: 'Diego Basso dirige',
    sottotitolo: 'Musica e cinema in un unico grande spettacolo',
    date: 'Prossime date',
    pausa: 'Metti in pausa il video',
    riproduci: 'Riproduci il video',
  },
  en: {
    occhiello: 'Diego Basso conducts',
    sottotitolo: 'Music and cinema in one great show',
    date: 'Upcoming dates',
    pausa: 'Pause the video',
    riproduci: 'Play the video',
  },
}[lang];
const Titolo = titolo ? 'h1' : 'div';
---

<figure class="om-cinemascope om-hero" data-hero>
  <div class="om-cinemascope__banda om-hero__alta">
    <p class="occhiello om-oro">{T.occhiello}</p>
  </div>
  <div class="om-cinemascope__finestra om-hero__finestra">
    <Picture
      src={POSTER.src}
      widths={[...POSTER.widths]}
      sizes={POSTER.sizes}
      formats={['avif', 'webp']}
      alt=""
      loading="eager"
      fetchpriority="high"
      class="om-hero__poster"
    />
    <video class="om-hero__video" muted loop playsinline preload="none" aria-hidden="true">
      <source src="/video/hero-1280.mp4" type="video/mp4" media="(max-width: 1024px)" />
      <source src="/video/hero-1920.mp4" type="video/mp4" />
    </video>
    <span class="om-grana" aria-hidden="true"></span>
    <button
      class="om-hero__pausa"
      type="button"
      aria-label={T.riproduci}
      data-pausa={T.pausa}
      data-riproduci={T.riproduci}
      hidden
    >
      <Icona nome="pause" class="om-hero__icona-pausa" />
      <Icona nome="play" class="om-hero__icona-play" />
    </button>
  </div>
  <figcaption class="om-cinemascope__banda om-hero__bassa">
    <Titolo class="om-hero__logo">
      <Logo forma="verticale" larghezza={360} caricamento="eager" />
    </Titolo>
    <div class="om-hero__azioni">
      <p class="om-cinemascope__sottotitolo">{T.sottotitolo}</p>
      <Pulsante href={hrefDate} lang={lang}>{T.date}</Pulsante>
    </div>
  </figcaption>
</figure>

<script is:inline>
  // Prima del primo disegno: decide se animare le bande (evita il salto 2,39:1 → 16:9).
  (function () {
    var hero = document.currentScript.previousElementSibling;
    var ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var risparmio = navigator.connection && navigator.connection.saveData;
    if (!ridotto && !risparmio) hero.setAttribute('data-anima', '');
  })();
</script>

<script>
  import '../scripts/hero.ts';
</script>

<style>
  /* La finestra è 16:9 nel disegno ma occupa lo spazio di una 2,39:1 (margini negativi):
     clip-path ritaglia le bande. 56,25 = 100·9/16; 41,841 = 100/2,39; 7,2045 = metà della differenza. */
  .om-hero {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  .om-hero__alta,
  .om-hero__bassa {
    flex: 1 0 auto;
  }

  .om-hero__alta {
    align-items: flex-end;
    padding-top: calc(var(--altezza-testata, 0px) + var(--spazio-4));
  }

  .om-hero__finestra {
    z-index: 1;
    aspect-ratio: var(--rapporto-video);
    margin-block: -7.2045cqw;
    clip-path: inset(7.2045cqw 0);
  }

  .om-hero[data-anima] .om-hero__finestra {
    animation: om-bande 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s both;
  }

  @keyframes om-bande {
    from {
      clip-path: inset(0 0);
    }
    to {
      clip-path: inset(7.2045cqw 0);
    }
  }

  .om-hero__finestra :global(picture) {
    display: contents;
  }

  .om-hero__finestra :global(.om-hero__poster),
  .om-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .om-hero__video {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .om-hero__video.is-in-riproduzione {
    opacity: 1;
  }

  /* Il pulsante sta dentro la parte visibile della finestra (sopra il ritaglio inferiore). */
  .om-hero__pausa {
    position: absolute;
    right: var(--margine-web);
    bottom: calc(7.2045cqw + var(--spazio-4));
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--linea-forte);
    border-radius: var(--raggio-1);
    background: var(--velo);
    color: var(--avorio);
  }

  .om-hero__pausa:hover {
    color: var(--oro);
    border-color: var(--oro);
  }

  .om-hero__pausa[hidden] {
    display: none;
  }

  .om-hero__pausa :global(.om-hero__icona-play),
  .om-hero__pausa[data-in-pausa] :global(.om-hero__icona-pausa) {
    display: none;
  }

  .om-hero__pausa[data-in-pausa] :global(.om-hero__icona-play) {
    display: block;
  }

  .om-hero__bassa {
    align-items: flex-start;
    padding-block: var(--spazio-6) var(--spazio-8);
  }

  .om-hero__logo :global(img) {
    width: clamp(240px, 25vw, 360px);
    height: auto;
  }

  .om-hero__azioni {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--spazio-4);
    text-align: right;
  }

  @media (max-width: 720px) {
    .om-hero__bassa {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: var(--spazio-6);
    }

    .om-hero__pausa {
      width: 36px;
      height: 36px;
      bottom: calc(7.2045cqw + var(--spazio-2));
    }

    .om-hero__azioni {
      align-items: stretch;
      text-align: left;
    }
  }
</style>
