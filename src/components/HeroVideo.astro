---
// Hero della Home (ARCHITECTURE.md §7.2): video a tutto schermo su desktop e mobile, in loop, in streaming HLS.
// Deroga al DS decisa dall'utente: niente bande fisse; testata, logo, sottotitolo e pulsante stanno sopra il video,
// leggibili grazie a due veli sfumati. Resta l'animazione firma: all'apertura il video è una finestra 2,39:1
// che in 0,8 s si apre a tutto schermo. Con reduced-motion o Save-Data niente animazione e niente video: resta il poster.
import { Picture } from 'astro:assets';
import type { Lingua } from './Seo.astro';
import { localizedPath, t } from '../i18n/utils';
import Logo from './Logo.astro';
import Pulsante from './Pulsante.astro';
import Icona from './Icona.astro';
import { POSTER, sorgenteVideo } from '../lib/hero';

interface Props {
  lang?: Lingua;
  hrefDate?: string;
  /** Il logo è l'h1 della pagina (Home). */
  titolo?: boolean;
}

const { lang = 'it', hrefDate = localizedPath('date', lang), titolo = true } = Astro.props;

const T = { ...t(lang).hero, riproduci: t(lang).comune.riproduciVideo };
const Titolo = titolo ? 'h1' : 'div';
---

<section class="hero" data-hero data-sorgente={sorgenteVideo}>
  <div class="hero__schermo">
    <Picture
      src={POSTER.src}
      widths={[...POSTER.widths]}
      sizes={POSTER.sizes}
      formats={['avif', 'webp']}
      alt=""
      loading="eager"
      fetchpriority="high"
      class="hero__poster"
    />
    <video class="hero__video" muted loop playsinline preload="none" aria-hidden="true"></video>
    <span class="om-grana" aria-hidden="true"></span>
    <span class="hero__velo" aria-hidden="true"></span>
  </div>

  <div class="hero__contenuto">
    <p class="occhiello om-oro">{T.occhiello}</p>
    <Titolo class="hero__logo">
      <Logo forma="verticale" larghezza={360} caricamento="eager" />
    </Titolo>
    <p class="om-cinemascope__sottotitolo">{T.sottotitolo}</p>
    <Pulsante href={hrefDate} lang={lang} class="hero__pulsante">{T.date}</Pulsante>
  </div>

  <button
    class="hero__pausa"
    type="button"
    aria-label={T.riproduci}
    data-pausa={T.pausa}
    data-riproduci={T.riproduci}
    hidden
  >
    <Icona nome="pause" class="hero__icona-pausa" />
    <Icona nome="play" class="hero__icona-play" />
  </button>
</section>

<script is:inline>
  // Prima del primo disegno: decide se animare (evita il salto tutto schermo → finestra).
  (function () {
    var hero = document.currentScript.previousElementSibling;
    var ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var risparmio = navigator.connection && navigator.connection.saveData;
    if (!ridotto && !risparmio) hero.setAttribute('data-anima', '');
  })();
</script>

<script>
  import '../scripts/hero.ts';
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: max(100svh, 520px);
    background: var(--sala-000);
    overflow: hidden;
  }

  .hero__schermo {
    position: absolute;
    inset: 0;
  }

  /* Animazione firma: parte come finestra 2,39:1 al centro (bande sala-000 sopra e sotto) e si apre. */
  .hero[data-anima] .hero__schermo {
    animation: om-sipario 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s both;
  }

  @keyframes om-sipario {
    from {
      clip-path: inset(max(0px, calc(50% - 20.92vw)) 0);
    }
    to {
      clip-path: inset(0 0);
    }
  }

  .hero__schermo :global(picture) {
    display: contents;
  }

  .hero__schermo :global(.hero__poster),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .hero__video.is-in-riproduzione {
    opacity: 1;
  }

  /* Veli: in alto per la testata trasparente, in basso per logo e testi. */
  .hero__velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, var(--velo) 0, transparent 22%),
      linear-gradient(to top, rgba(5, 4, 4, 0.85) 0, var(--velo) 28%, transparent 62%);
    pointer-events: none;
  }

  .hero__contenuto {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spazio-4);
    width: 100%;
    max-width: calc(1440px + 2 * var(--margine-web));
    margin-inline: auto;
    padding: var(--spazio-24) var(--margine-web) var(--spazio-12);
  }

  .hero[data-anima] .hero__contenuto {
    animation: om-compari 0.6s ease 1s both;
  }

  @keyframes om-compari {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .hero__logo :global(img) {
    width: clamp(240px, 25vw, 360px);
    height: auto;
  }

  .hero__contenuto :global(.hero__pulsante) {
    margin-top: var(--spazio-2);
  }

  .hero__pausa {
    position: absolute;
    right: var(--margine-web);
    bottom: var(--spazio-12);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--linea-forte);
    border-radius: var(--raggio-1);
    background: var(--velo);
    color: var(--avorio);
  }

  .hero__pausa:hover {
    color: var(--oro);
    border-color: var(--oro);
  }

  .hero__pausa[hidden] {
    display: none;
  }

  .hero__pausa :global(.hero__icona-play),
  .hero__pausa[data-in-pausa] :global(.hero__icona-pausa) {
    display: none;
  }

  .hero__pausa[data-in-pausa] :global(.hero__icona-play) {
    display: block;
  }

  @media (max-width: 720px) {
    .hero__contenuto {
      align-items: stretch;
      padding-bottom: var(--spazio-8);
    }

    .hero__contenuto :global(.hero__pulsante) {
      width: 100%;
    }

    .hero__pausa {
      top: calc(var(--altezza-testata) + var(--spazio-2));
      bottom: auto;
    }
  }
</style>
