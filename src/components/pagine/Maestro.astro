---
// Il Maestro (ARCHITECTURE.md §5): "La visione del Maestro Diego Basso" dal docx alla lettera.
// Primo paragrafo nella scena a tutto schermo con lo scontorno (ScenaMaestro); gli altri due (Alessandroni, Griminelli, "Lost Boys Calling") sono le
// collaborazioni; chiude la Formazione con Crediti e la foto di soprano e direttore.
import type { Lingua } from '../Seo.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Testata from '../Testata.astro';
import Sezione from '../Sezione.astro';
import ScenaMaestro from '../ScenaMaestro.astro';
import Cinemascope from '../Cinemascope.astro';
import Crediti from '../Crediti.astro';
import Footer from '../Footer.astro';
import { paragrafi, testo } from '../../lib/testi';
import { alternate, t } from '../../i18n/utils';

interface Props {
  lang: Lingua;
}

const { lang } = Astro.props;
const D = t(lang);

const visione = await testo('visione', lang);
const [apertura, ...collaborazioni] = paragrafi(visione.body ?? '');
const formazione = await testo('formazione', lang);
---

<BaseLayout
  title={`${D.menu.maestro} — Omaggio a Ennio Morricone`}
  description={D.seo.maestro}
  lang={lang}
  alternate={alternate('maestro')}
  og="/og/maestro.jpg"
>
  <Testata slot="testata" lang={lang} corrente="maestro" />
  <ScenaMaestro lang={lang} titolo={visione.data.titolo} apertura>
    <p class="corpo" set:html={apertura} />
  </ScenaMaestro>

  <Sezione id="collaborazioni" titolo={D.maestro.collaborazioni} affiancata>
    <div class="testo corpo">
      {collaborazioni.map((p) => <p set:html={p} />)}
    </div>
  </Sezione>

  <section class="sezione" data-reveal>
    <Cinemascope foto="luogo-aperto-01" lang={lang} />
  </section>

  <Sezione id="formazione" titolo={formazione.data.titolo}>
    <Crediti lang={lang} />
  </Sezione>

  <section class="sezione" data-reveal>
    <Cinemascope foto="soprano-02" lang={lang} />
  </section>

  <Footer slot="piede" lang={lang} />
</BaseLayout>
