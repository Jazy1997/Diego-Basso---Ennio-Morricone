---
// Il repertorio in una frase (decisione dell'utente, ott. 2026: niente scaletta completa).
// Titoli dei film in corsivo; in EN i titoli dell'edizione inglese, come nei testi (DS › Tono).
import type { Lingua } from './Seo.astro';
import { t } from '../i18n/utils';

interface Props {
  lang?: Lingua;
}

const { lang = 'it' } = Astro.props;
---

<blockquote class="repertorio">
  <p class="evocativo-xl" data-illumina set:html={t(lang).repertorio.citazione} />
</blockquote>

<style>
  .repertorio {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    color: var(--avorio);
  }

  /* Frase in tondo, titoli dei film in corsivo; niente oro (DS: oro ≤ 10%). */
  .repertorio p {
    margin: 0;
    font-style: normal;
  }
</style>
