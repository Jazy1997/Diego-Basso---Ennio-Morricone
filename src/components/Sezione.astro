---
// Sezione di pagina (ARCHITECTURE.md §6, §8): spaziatura DS, occhiello oro + titolo h2, comparsa con Reveal.
// `contenitore` (predefinito) limita la larghezza e applica i margini web; senza, la sezione va a tutta larghezza.
// `affiancata`: da 1100 px titolo a sinistra (fermo mentre il testo scorre) e contenuto a destra, così la colonna
// di testo non lascia metà schermo vuota; sotto 1100 px una colonna sola. Lo slot "testa" aggiunge contenuto
// sotto il titolo, nella colonna di sinistra.
interface Props {
  id?: string;
  occhiello?: string;
  titolo?: string;
  /** Classe tipografica del titolo: `titolo-l` (predefinita) o `evocativo-xl` per un claim. */
  stileTitolo?: 'titolo-l' | 'evocativo-xl';
  centrato?: boolean;
  affiancata?: boolean;
  contenitore?: boolean;
  class?: string;
}

const {
  id,
  occhiello,
  titolo,
  stileTitolo = 'titolo-l',
  centrato = false,
  affiancata = false,
  contenitore = true,
  class: classe,
} = Astro.props;
const testa = occhiello || titolo || Astro.slots.has('testa');
---

<section
  class:list={[
    'sezione',
    contenitore && 'contenitore',
    centrato && 'sezione--centrata',
    affiancata && 'sezione--affiancata',
    classe,
  ]}
  id={id}
  data-reveal
>
  {
    testa && (
      <div class="sezione__testa">
        {occhiello && <p class="occhiello om-oro">{occhiello}</p>}
        {titolo && <h2 class={stileTitolo}>{titolo}</h2>}
        <slot name="testa" />
      </div>
    )
  }
  {
    affiancata ? (
      <div class="sezione__corpo">
        <slot />
      </div>
    ) : (
      <slot />
    )
  }
</section>

<style>
  .sezione--centrata .sezione__testa {
    align-items: center;
    text-align: center;
  }

  @media (min-width: 1100px) {
    .sezione--affiancata {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--spazio-16);
      align-items: start;
    }

    .sezione--affiancata .sezione__testa {
      position: sticky;
      top: calc(var(--altezza-testata) + var(--spazio-8));
      margin-bottom: 0;
    }

    /* Senza titolo il contenuto resta comunque nella colonna di destra */
    .sezione--affiancata > .sezione__corpo:first-child {
      grid-column: 2;
    }
  }
</style>
